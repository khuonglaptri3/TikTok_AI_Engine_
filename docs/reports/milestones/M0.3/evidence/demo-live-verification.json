  "observed_ui_issues_and_limitations": [
    {
      "id": "M0.3-UI-1",
      "severity": "Low",
      "location": "apps/demo/ui.py:117-119 (handle_explore_evidence)",
      "description": "When /api/v1/retrieval/search returns a FastAPI/Pydantic 422 RequestValidationError (e.g., whitespace-only query '   ') rather than a domain ViralRagError, r_data contains {'detail': [...]} without a top-level 'message' key. Consequently r_data.get('message', '') evaluates to '', rendering '### ⚠️ Lỗi truy xuất (`422`)' with an empty message body in Tab 2.",
      "observed_output": "### ⚠️ Lỗi truy xuất (`422`)\n"
    },
    {
      "id": "M0.3-UI-2",
      "severity": "Low",
      "location": "apps/demo/ui.py:71-73 & 157-158 (handle_generate_script, handle_trust_audit)",
